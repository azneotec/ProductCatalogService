meta {
  name: List Products
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/products
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("FakeStore-shaped products", function () {
    expect(res.body).to.be.an("array").and.not.empty;
    expect(res.body[0]).to.include.keys(["id", "title", "price", "description", "category", "image", "rating"]);
  });
}

docs {
  Public.
}
