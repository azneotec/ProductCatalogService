# Copy to .env and fill in. .env is gitignored; load it with: set -a; source .env; set +a
# Port 3308 is the MySQL from `make infra-up`; use 3306 for a MySQL installed on the host.
DB_URL='jdbc:mysql://localhost:3308/product_catalog_service'
DB_USERNAME='root'
DB_PASSWORD='password'
# Optional. The app listens on 8002 by default; set 9002 to run a second instance beside it.
# Anything set here overrides that default, so leave it unset for the normal single-instance run.
# SERVER_PORT='9002'
